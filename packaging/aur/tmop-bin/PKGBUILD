# Maintainer: tekikaito <https://github.com/tekikaito>
pkgname=tmop-bin
pkgver=0.14.1
pkgrel=1
pkgdesc='Task Manager OverPowered: a skinnable task manager and system monitor (prebuilt release)'
arch=('x86_64' 'aarch64')
url='https://tekikaito.github.io/tmop/'
license=('GPL-3.0-only')
# The binary links only glibc and libgcc_s. The GUI stack loads libxkbcommon-x11 with dlopen
# and panics on X11 without it. X11, Wayland, OpenGL, libdbus-1 and libnvidia-ml are loaded with
# dlopen too (checked with readelf -d and strings on 0.14.1).
depends=('glibc' 'gcc-libs' 'libxkbcommon-x11')
optdepends=(
    'wayland: run as a native Wayland client'
    'libx11: run as a native X11 client'
    'libglvnd: OpenGL, which TMOP draws its window with (needs a graphics driver, e.g. mesa)'
    'xdg-desktop-portal: file dialogs'
    'docker: show and manage containers'
    'dbus: desktop integration over D-Bus'
    'nvidia-utils: NVIDIA GPU statistics (libnvidia-ml)'
)
provides=('tmop')
conflicts=('tmop')
options=('!debug')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::https://github.com/tekikaito/tmop/releases/download/v$pkgver/TMOP-v$pkgver-linux-x64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::https://github.com/tekikaito/tmop/releases/download/v$pkgver/TMOP-v$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('d9320c2fb018262eafaf91c113b2ab3bfd101564f4cd2469061f7097a7b4f2ba')
sha256sums_aarch64=('1a52da014e611d4e8bb8873166b4d1e34f3cba069b9a0027c67732c286b2d308')

package() {
    local dir
    case "$CARCH" in
        x86_64) dir="TMOP-v$pkgver-linux-x64" ;;
        aarch64) dir="TMOP-v$pkgver-linux-arm64" ;;
    esac
    cd "$srcdir/$dir"

    install -Dm755 tmop "$pkgdir/usr/bin/tmop"
    install -Dm644 tmop.desktop "$pkgdir/usr/share/applications/tmop.desktop"
    local size
    for size in 64 256 512 1024; do
        install -Dm644 "icons/hicolor/${size}x${size}/apps/tmop.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/tmop.png"
    done
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
    install -Dm644 LICENSE Michroma-OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
